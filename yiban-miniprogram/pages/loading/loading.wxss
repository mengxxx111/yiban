/* pages/loading/loading.wxss */
.ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(212, 175, 106, 0.2);
  border-top-color: var(--gold);
  animation: spin 1.2s linear infinite;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 88rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.ring-inner {
  width: 216rpx;
  height: 216rpx;
  border-radius: 50%;
  background: rgba(212, 175, 106, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-text {
  font-size: 48rpx;
  color: var(--gold-bright);
  font-weight: 600;
}

.lunar-note {
  font-size: 30rpx;
  color: var(--text-dim);
  letter-spacing: 4rpx;
  text-align: center;
}

/* 进度 = 底色填充（v2） */
.progress-line {
  width: 320rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
  margin: 0 auto 36rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #b08d4f, #e8c98f);
  transition: width 0.16s linear;
  box-shadow: 0 0 16rpx rgba(232, 196, 92, 0.5);
}
