/* pages/form/form.wxss */
.topbar {
  display: flex;
  align-items: center;
  padding: 8rpx 0 40rpx;
}

.back {
  width: 64rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 52rpx;
  color: var(--text-dim);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  margin-right: 24rpx;
}

.step {
  font-size: 26rpx;
  color: var(--text-dim);
  letter-spacing: 2rpx;
}

.section { margin-bottom: 48rpx; }

.sec-title {
  font-size: 30rpx;
  color: var(--text-hi);
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}

.sec-no {
  color: var(--gold-bright);
  font-size: 26rpx;
  margin-right: 8rpx;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.opt-card {
  flex: 1 1 40%;
  min-width: 280rpx;
  box-sizing: border-box;
  background: var(--bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.opt-card--on {
  border-color: var(--gold);
  background: var(--gold-faint);
  box-shadow: 0 8rpx 28rpx rgba(212, 175, 106, 0.14);
  animation: popIn 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.opt-label {
  font-size: 32rpx;
  color: var(--text-hi);
  letter-spacing: 2rpx;
}

.opt-desc {
  font-size: 24rpx;
  color: var(--text-dim);
  margin-top: 8rpx;
}

.opt-card--style .opt-label { font-size: 40rpx; letter-spacing: 8rpx; }

/* 生日 */
.birth-card { padding: 32rpx 28rpx; }

.birth-pickers {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pick {
  font-size: 40rpx;
  color: var(--text-hi);
  letter-spacing: 2rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(212, 175, 106, 0.3);
  border-radius: 18rpx;
  padding: 18rpx 34rpx;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.2s ease, background 0.2s ease;
}

.pick:active {
  transform: scale(0.95);
  border-color: var(--gold);
  background: rgba(212, 175, 106, 0.12);
}

.pick-unit {
  font-size: 24rpx;
  color: var(--text-faint);
  margin-left: 6rpx;
}

.birth-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 28rpx;
  gap: 12rpx;
}

.lunar-toggle {
  font-size: 24rpx;
  color: var(--gold-bright);
  margin-left: auto;
  letter-spacing: 1rpx;
}

/* 地域 */
.section--soft { margin-top: 8rpx; }

.sec-title--soft {
  font-size: 26rpx;
  color: var(--text-dim);
  letter-spacing: 2rpx;
}

.chips-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip--pick {
  color: var(--text-dim);
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  padding: 14rpx 36rpx;
}

.chip--on {
  color: var(--gold-bright);
  border-color: var(--gold-soft);
  background: var(--gold-faint);
}

/* 行动 */
.act {
  width: 100%;
  height: 100rpx;
  font-size: 32rpx;
  margin-top: 12rpx;
}

.act--disabled {
  opacity: 0.38;
  pointer-events: none;
}

.quiz-entry {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-faint);
  margin-top: 28rpx;
  letter-spacing: 1rpx;
}

.btn-press { transform: scale(0.98); }
