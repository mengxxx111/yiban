/* pages/quiz/quiz.wxss */
.topbar {
  display: flex;
  align-items: center;
  padding: 8rpx 0 32rpx;
}

.back {
  width: 64rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 52rpx;
  color: var(--text-dim);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  margin-right: 24rpx;
}

.step {
  font-size: 26rpx;
  color: var(--text-dim);
  letter-spacing: 2rpx;
}

.progress {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
  margin-bottom: 48rpx;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #b08d4f, #e8c98f);
  transition: width 0.3s ease;
}

.q-card {
  padding: 64rpx 48rpx;
  min-height: 200rpx;
  display: flex;
  align-items: center;
}

.q-text {
  font-size: 40rpx;
  color: var(--text-hi);
  line-height: 1.6;
  letter-spacing: 2rpx;
}

.opts {
  margin-top: 44rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.opt {
  width: 100%;
  min-height: 96rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  padding: 0 36rpx;
  text-align: left;
  justify-content: flex-start;
  color: var(--text);
  border-color: rgba(255, 255, 255, 0.16);
}

.opt-press { background: var(--gold-faint); border-color: var(--gold-soft) !important; }

/* 结果 */
.type-badge {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 2rpx solid var(--gold);
  background: radial-gradient(circle at 50% 40%, rgba(212, 175, 106, 0.16), transparent 70%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  box-shadow: 0 0 0 14rpx rgba(212, 175, 106, 0.06);
}

.type-text {
  font-size: 72rpx;
  font-weight: 600;
  color: var(--gold-bright);
  letter-spacing: 6rpx;
}

.type-name {
  font-size: 40rpx;
  color: var(--text-hi);
  letter-spacing: 6rpx;
  margin-bottom: 24rpx;
}

.type-desc {
  font-size: 30rpx;
  color: var(--text);
  line-height: 1.8;
  padding: 0 24rpx;
  margin-bottom: 72rpx;
}

.act {
  width: 440rpx;
  height: 96rpx;
}

.btn-press { transform: scale(0.98); }
